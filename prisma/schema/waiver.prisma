enum FeeType {
  ADMISSION
  ANNUAL
  MONTHLY
}

enum DiscountType {
  AMOUNT
  PERCENTAGE
}

enum WaiverStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model Waiver {
  id            String       @id @default(uuid()) @db.Uuid
  profileId     String       @db.Uuid
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  feeType       FeeType
  discountType  DiscountType
  value         Decimal      @db.Decimal(12, 2)
  startDate     DateTime     @db.Date
  endDate       DateTime?    @db.Date
  reason        String
  status        WaiverStatus @default(PENDING)
  requestedById String       @db.Uuid
  requestedBy   User         @relation("WaiverRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?      @db.Uuid
  decidedBy     User?        @relation("WaiverApprover", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([profileId, feeType, status])
  @@map("waivers")
}
