model HomeVisit {
  id               String      @id @default(uuid()) @db.Uuid
  studentInfoId    String      @db.Uuid
  studentInfo      StudentInfo @relation(fields: [studentInfoId], references: [id], onDelete: Cascade)
  visitedById      String      @db.Uuid
  visitedBy        User        @relation(fields: [visitedById], references: [id], onDelete: Restrict)
  visitDate        DateTime    @default(now())
  notes            String
  nextFollowUpDate DateTime?   @db.Date
  createdAt        DateTime    @default(now())

  @@index([studentInfoId, visitDate])
  @@index([visitedById])
  @@map("home_visits")
}
