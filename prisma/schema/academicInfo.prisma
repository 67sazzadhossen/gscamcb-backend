enum AdmissionStatus {
  PROSPECT
  FOLLOW_UP
  INTERESTED
  APPLIED
  ADMITTED
  NOT_INTERESTED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

model AcademicInfo {
  id               String          @id @default(uuid()) @db.Uuid
  profileId        String          @unique @db.Uuid
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  admissionClassId String?         @db.Uuid
  admissionClass   Class?          @relation("AdmissionClass", fields: [admissionClassId], references: [id], onDelete: Restrict)
  currentClassId   String?         @db.Uuid
  currentClass     Class?          @relation("CurrentClass", fields: [currentClassId], references: [id], onDelete: Restrict)
  sectionId        String?         @db.Uuid
  section          Section?        @relation(fields: [sectionId, currentClassId], references: [id, classId], onDelete: Restrict)
  rollNumber       Int?
  academicYear     Int?
  admittedById     String?         @db.Uuid
  admittedBy       User?           @relation("AdmissionApprover", fields: [admittedById], references: [id], onDelete: SetNull)
  admissionStatus  AdmissionStatus @default(PROSPECT)
  studentStatus    StudentStatus?
  admissionDate    DateTime?       @db.Date
  admissionYear    Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([currentClassId, sectionId, academicYear, rollNumber])
  @@index([admittedById])
  @@map("academic_info")
}
