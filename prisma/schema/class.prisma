model Class {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @unique
  sections   Section[]
  admissions AcademicInfo[] @relation("AdmissionClass")
  students   AcademicInfo[] @relation("CurrentClass")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("classes")
}

model Section {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  classId   String         @db.Uuid
  class     Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  students  AcademicInfo[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([classId, name])
  @@unique([id, classId])
  @@map("sections")
}
